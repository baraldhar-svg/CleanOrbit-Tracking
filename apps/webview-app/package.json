{
  "name": "webview-app",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "expo": "~51.0.0",
    "expo-location": "~17.0.1",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-webview": "13.8.6",
    "babel-preset-expo": "~11.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0"
  },
  "scripts": {
    "eas-build-pre-build": "mkdir -p dist && node node_modules/react-native/cli.js bundle --platform android --dev false --entry-file index.js --bundle-output dist/index.android.bundle || (echo 'METRO_FAILED' && exit 1)",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "private": true
}
