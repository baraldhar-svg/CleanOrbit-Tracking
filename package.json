{
    "name": "workspace",
    "version": "0.0.0",
    "license": "MIT",
    "scripts": {
        "build": "pnpm run typecheck && pnpm --filter @workspace/api-server --filter @workspace/fleetsaas --if-present run build",
        "build:backend": "pnpm --filter @workspace/api-server run build",
        "build:frontend": "pnpm --filter @workspace/fleetsaas run build",
        "start": "pnpm --filter @workspace/api-server start",
        "start:backend": "pnpm --filter @workspace/api-server start",
        "typecheck:libs": "tsc --build",
        "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./apps/frontend\" --filter \"./apps/backend\" --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
        "dev": "pnpm --filter @workspace/api-server --filter @workspace/fleetsaas --parallel dev"
    },
    "private": true,
    "devDependencies": {
        "@capacitor/cli": "^8.5.0",
        "prettier": "^3.8.3",
        "typescript": "~5.9.3"
    },
    "dependencies": {
        "@capacitor/android": "^8.5.0",
        "@capacitor/core": "^8.5.0",
        "node-abort-controller": "^3.1.1"
    },
    "packageManager": "pnpm@10.11.1"
}
