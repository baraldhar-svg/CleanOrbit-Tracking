# ==============================================================================
# Supabase PostgreSQL Database Connection
# ==============================================================================
# Connection pooler URL from Supabase project settings (Database -> Connection String)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbooster=true
DATABASE_URL="postgresql://postgres:your_password@db.your-supabase-id.supabase.co:5432/postgres"

# Optional Supabase API Credentials (if using Supabase Auth / Storage)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ==============================================================================
# Backend & Vercel Serverless Function Configuration
# ==============================================================================
PORT=8080
SESSION_SECRET="your_very_secret_jwt_session_key_here"
LOG_LEVEL="info"

# Security & Features
QR_TOKEN_SECRET="your_very_secret_qr_token_key_here"
DELAY_THRESHOLD_MINUTES=15
PROXIMITY_ETA_THRESHOLD=5

# ==============================================================================
# Frontend & Mobile Configuration
# ==============================================================================
VITE_API_URL="/api"
EXPO_PUBLIC_DOMAIN="localhost"
